# Servidor
PORT=3333
JWT_SECRET=troque-este-valor-em-producao

# Banco de Dados (Supabase) — Settings > Database > Connection string.
# DATABASE_URL: Transaction pooler (porta 6543), usado pela aplicação em
# runtime. O ?pgbouncer=true é obrigatório — o PgBouncer em modo transação
# não suporta prepared statements, que o Prisma usa por padrão; sem essa
# flag toda query falha com "prepared statement already exists".
# DIRECT_URL: Session pooler (porta 5432), usado só pelo Prisma Migrate.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Role restrito app_backend (Fase 4, migration tenant_write_rls) — sem
# BYPASSRLS. Usado só dentro de withTenant/writeWithTenant para escritas.
DATABASE_URL_RESTRICTED="postgresql://app_backend.xxxxxxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth (Admin API) — Project Settings > API Keys.
# SUPABASE_SERVICE_ROLE_KEY é secreta: bypassa RLS e a Admin API inteira.
# Nunca expor no frontend, nunca commitar.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="troque-por-service-role-key-real"
SUPABASE_ANON_KEY="troque-por-anon-publishable-key-real"

# URL pública do front-end — usada para montar os links de convite/aprovação
# enviados por e-mail (dev: Vite; produção: domínio real) E como origin
# aceita pelo CORS. Se a porta pela qual você abre a app não estiver aqui
# (nem em CORS_ORIGINS), o navegador descarta TODA resposta da API e a tela
# fica sem dados.
FRONTEND_URL=http://localhost:5173

# Origins extras aceitas pelo CORS, separadas por vírgula. Opcional: vazio
# = só a FRONTEND_URL, que é o caso de produção. Em dev, serve para abrir o
# build de preview (`vite preview`, porta 4173) além do dev server (5173).
# CORS_ORIGINS=http://localhost:4173

# SMTP próprio (Resend: Settings > API Keys, SMTP host smtp.resend.com porta
# 587, usuário "resend", senha = API key). O backend envia convite e
# aprovação de empresa diretamente por aqui, sem depender do SMTP embutido
# do Supabase (rate limit baixo, não suportado para produção).
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="troque-pela-api-key-do-resend"
SMTP_FROM="Metas e Comissões <onboarding@resend.dev>"

# E-mail do Super Admin da plataforma que recebe os pedidos de liberação de
# nova empresa (cadastro via botão "Nova Empresa" na tela de login).
PLATFORM_ADMIN_EMAIL="rossin@rossinvendas.com"

# Frontend (Vite)
VITE_API_URL=http://localhost:3333/api
# Mesmas URL/chave pública acima — Vite só expõe variáveis prefixadas com
# VITE_. Usadas no fluxo de aceite de convite.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="troque-por-anon-publishable-key-real"
